# API settings. Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=3000
# The API connects as the app role (row-level security applies to it)
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/billing_erp
# Migrations run as the owner role
MIGRATE_DATABASE_URL=postgresql://erp_owner:erp_owner@localhost:5432/billing_erp
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# true in production (HTTPS only)
COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:5173
TRIAL_DAYS=14
# "Open the demo shop" on the sign-in page
DEMO_ENABLED=true
DEMO_EMAIL=aman@sharma.example.com
DEMO_PASSWORD=demo-password-1
