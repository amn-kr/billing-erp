// Billing ERP — database schema.
//
// Rules (see CLAUDE.md and docs/ARCHITECTURE.md):
// - every shop-owned table has business_id, protected by row-level security
//   (policies live in the SQL migrations, not here);
// - UUID ids, created_by / created_at / updated_at;
// - money is numeric(14,2), quantities numeric(14,3);
// - documents are cancelled (cancelled_at), never deleted.
//
// Phase 1 covers accounts & SaaS, setup and the audit log. Masters and
// transactions are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Accounts & SaaS ─────────────────────────

/// A person who can sign in. Not owned by a shop: one person can belong to several shops.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  name          String    @default("")
  phone         String    @default("")
  passwordHash  String    @map("password_hash")
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// this person's display choices: comfortable | compact, and small | normal | large
  uiDensity     String    @default("comfortable") @map("ui_density")
  uiTextSize    String    @default("normal") @map("ui_text_size")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordReset[]

  @@map("users")
}

/// A shop (tenant). Its id is the business_id every other shop table points to.
model Business {
  id          String    @id @db.Uuid
  /// Short public code shown in the account menu, e.g. BE-1012.
  code        String    @unique
  name        String
  shortName   String    @map("short_name")
  ownerId     String    @map("owner_user_id") @db.Uuid
  phone       String    @default("")
  email       String    @default("")
  address     String    @default("")
  city        String    @default("")
  pin         String    @default("")
  stateCode   String    @map("state_code")
  gstin       String    @default("")
  /// trial | paid | expired
  planStatus  String    @default("trial") @map("plan_status")
  trialEndsOn DateTime  @map("trial_ends_on") @db.Date
  paidUntil   DateTime? @map("paid_until") @db.Date
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           Membership[]
  invites               Invite[]
  settings              BusinessSettings?
  priceLock             PriceLock?
  txnPasscode           TxnPasscode?
  cashBankAccounts      CashBankAccount[]
  salesDocuments        SalesDocument[]
  salesDocumentLines    SalesDocumentLine[]
  purchaseDocuments     PurchaseDocument[]
  purchaseDocumentLines PurchaseDocumentLine[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  bankEntries           BankEntry[]
  cheques               Cheque[]
  reconciliations       Reconciliation[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  expenseLines          ExpenseLine[]
  commissionPayouts     CommissionPayout[]
  ledgerAccounts        LedgerAccount[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]
  financialYears        FinancialYear[]
  series                DocumentSeries[]
  taxRates              TaxRate[]
  subscriptions         Subscription[]
  partyGroups           PartyGroup[]
  parties               Party[]
  units                 Unit[]
  categories            Category[]
  brands                Brand[]
  brandSeries           BrandSeries[]
  itemGroups            ItemGroup[]
  hsnCodes              HsnCode[]
  items                 Item[]
  godowns               Godown[]
  priceLists            PriceList[]
  referrers             Referrer[]
  imports               ImportRun[]

  @@map("businesses")
}

/// System roles have business_id NULL; a shop may add its own later.
model Role {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String?  @map("business_id") @db.Uuid
  /// owner | manager | billing_staff | accountant (or a custom key)
  key        String
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  memberships Membership[]
  invites     Invite[]

  @@unique([businessId, key])
  @@map("roles")
}

model RolePermission {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String  @map("role_id") @db.Uuid
  businessId String? @map("business_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, permission])
  @@map("role_permissions")
}

/// A person's place in a shop.
model Membership {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  displayName String    @default("") @map("display_name")
  /// active | removed
  status      String    @default("active")
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  email      String
  roleId     String    @map("role_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([businessId])
  @@map("invites")
}

/// A signed-in device. The refresh token is stored only as a SHA-256 hash.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String    @default("") @map("user_agent")
  ip         String    @default("")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

/// Plans you sell (global).
model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique
  name         String
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(14, 2)
  priceYearly  Decimal  @map("price_yearly") @db.Decimal(14, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String   @map("business_id") @db.Uuid
  planId                 String   @map("plan_id") @db.Uuid
  /// pending | active | cancelled | expired
  status                 String
  /// month | year
  billingPeriod          String   @map("billing_period")
  startsOn               DateTime @map("starts_on") @db.Date
  endsOn                 DateTime @map("ends_on") @db.Date
  razorpaySubscriptionId String?  @map("razorpay_subscription_id")
  createdBy              String   @map("created_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business              @relation(fields: [businessId], references: [id])
  plan     Plan                  @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([businessId])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  amount            Decimal   @db.Decimal(14, 2)
  /// created | paid | failed | refunded
  status            String
  razorpayPaymentId String?   @map("razorpay_payment_id")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([businessId])
  @@map("subscription_payments")
}

// ───────────────────────── Setup ─────────────────────────

model BusinessSettings {
  businessId String   @id @map("business_id") @db.Uuid
  gstEnabled Boolean  @default(false) @map("gst_enabled")
  /// Everything else from the prototype's Settings screens, filled in by later phases.
  data       Json     @default("{}")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("business_settings")
}

/// Price manager PIN (Price Setup). Kept apart from settings so the hash never travels with them.
model PriceLock {
  businessId String    @id @map("business_id") @db.Uuid
  pinHash    String    @map("pin_hash")
  /// wrong tries in a row; 5 locks the PIN for 60 seconds
  fails      Int       @default(0)
  waitUntil  DateTime? @map("wait_until") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("price_locks")
}

/// Transaction passcode (Settings › Transactions): asked when a saved document is changed or cancelled.
/// Kept apart from settings so the hash never travels with them; the switch lives here too, so the
/// settings save can't turn it off without the passcode.
model TxnPasscode {
  businessId   String    @id @map("business_id") @db.Uuid
  enabled      Boolean   @default(false)
  passcodeHash String    @map("passcode_hash")
  /// wrong tries in a row; 5 locks the passcode for 60 seconds
  fails        Int       @default(0)
  waitUntil    DateTime? @map("wait_until") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("txn_passcodes")
}

model FinancialYear {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// e.g. 2026-27
  label      String
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  isClosed   Boolean  @default(false) @map("is_closed")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business         @relation(fields: [businessId], references: [id])
  series   DocumentSeries[]

  @@unique([businessId, label])
  @@map("financial_years")
}

/// Document numbering: the server assigns numbers, per type per financial year.
model DocumentSeries {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  /// the year the row was made in (older rows); numbering itself no longer depends on it
  financialYearId String?  @map("financial_year_id") @db.Uuid
  /// invoice | quotation | challan | credit_note | receipt | purchase_order | bill | debit_note | payment | expense
  docType         String   @map("doc_type")
  /// "" = None (numbers without a prefix)
  prefix          String
  nextNumber      Int      @map("next_number")
  padding         Int      @default(4)
  /// the one prefix of its type used for new documents (a partial unique index allows only one)
  active          Boolean  @default(false)
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business      @relation(fields: [businessId], references: [id])
  financialYear FinancialYear? @relation(fields: [financialYearId], references: [id])

  @@unique([businessId, docType, prefix])
  @@map("document_series")
}

model TaxRate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// GST | TCS | TDS
  kind       String   @default("GST")
  name       String
  rate       Decimal  @db.Decimal(5, 2)
  note       String   @default("")
  /// older slab kept for earlier bills (prototype "old")
  isOld      Boolean  @default(false) @map("is_old")
  legacyId   String?  @map("legacy_id")
  isDefault  Boolean  @default(false) @map("is_default")
  active     Boolean  @default(true)
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, kind, name])
  @@map("tax_rates")
}

// ───────────────────────── System ─────────────────────────

/// Append-only: the app role may insert and read, never update or delete.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// create | update | cancel | sign_in | invite | ...
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId, createdAt])
  @@map("audit_log")
}

// ───────────────────────── Parties ─────────────────────────

model PartyGroup {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business       Business        @relation(fields: [businessId], references: [id])
  parties        Party[]
  priceListRules PriceListRule[]

  @@unique([businessId, name])
  @@map("party_groups")
}

/// A customer or supplier. Never deleted: archived.
model Party {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  name           String
  /// customer | supplier
  kind           String
  groupId        String?   @map("group_id") @db.Uuid
  phone          String    @default("")
  email          String    @default("")
  gstin          String    @default("")
  /// printed under Bill To instead of the name when filled (Settings › Transactions › Billing name of parties)
  billingName    String    @default("") @map("billing_name")
  /// e.g. "Registered business – regular", "Unregistered / consumer"
  gstType        String    @default("") @map("gst_type")
  /// place of supply (GST state code); blank = the shop's own state
  stateCode      String    @default("") @map("state_code")
  /// null = no limit
  creditLimit    Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  creditDays     Int       @default(0) @map("credit_days")
  /// positive amount; openingType says which way
  openingBalance Decimal   @default(0) @map("opening_balance") @db.Decimal(14, 2)
  /// receive (they owe us) | pay (we owe them)
  openingType    String    @default("receive") @map("opening_type")
  openingDate    DateTime? @map("opening_date") @db.Date
  notes          String    @default("")
  /// id in the prototype's books, for imports
  legacyId       String?   @map("legacy_id")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  /// deleted (never used): hidden everywhere, kept for good (archived_at is set too)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business          Business           @relation(fields: [businessId], references: [id])
  group             PartyGroup?        @relation(fields: [groupId], references: [id])
  addresses         PartyAddress[]
  contacts          PartyContact[]
  referrers         Referrer[]
  salesDocuments    SalesDocument[]
  purchaseDocuments PurchaseDocument[]
  payments          Payment[]

  @@index([businessId, name])
  @@index([businessId, legacyId])
  @@map("parties")
}

model PartyAddress {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  partyId    String   @map("party_id") @db.Uuid
  /// billing | shipping
  kind       String
  line       String   @default("")
  city       String   @default("")
  pin        String   @default("")
  stateCode  String   @default("") @map("state_code")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  party Party @relation(fields: [partyId], references: [id])

  @@unique([partyId, kind])
  @@map("party_addresses")
}

/// The prototype's "Additional fields": contact person, birthday, anniversary, transport.
model PartyContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  partyId    String   @map("party_id") @db.Uuid
  label      String
  value      String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  party Party @relation(fields: [partyId], references: [id])

  @@map("party_contacts")
}

// ───────────────────────── Catalogue ─────────────────────────

model Unit {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  /// PCS, BOX, KG, MTR, COIL, …
  code       String
  /// full name, e.g. "Coil" (empty for units made before names existed)
  name       String    @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business       Business @relation(fields: [businessId], references: [id])
  items          Item[]   @relation("ItemUnit")
  secondaryItems Item[]   @relation("ItemSecondaryUnit")

  @@unique([businessId, code])
  @@map("units")
}

model Category {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business         @relation(fields: [businessId], references: [id])
  items           Item[]
  commissionRules CommissionRule[]

  @@unique([businessId, name])
  @@map("categories")
}

model Brand {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  notes      String    @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business      @relation(fields: [businessId], references: [id])
  items    Item[]
  series   BrandSeries[]

  @@unique([businessId, name])
  @@map("brands")
}

/// A brand's series (e.g. Havells "Coral"), added on Brands & Series. Items keep their series as text
/// (items.series); a series here matches items of the same brand by name, ignoring capital letters.
model BrandSeries {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  brandId    String    @map("brand_id") @db.Uuid
  name       String
  size       String    @default("")
  notes      String    @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])

  @@index([businessId, brandId])
  @@map("brand_series")
}

/// An item family whose variants differ by brand and size, e.g. "Copper wire (90 m)".
model ItemGroup {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  items    Item[]

  @@unique([businessId, name])
  @@map("item_groups")
}

model HsnCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  code        String
  description String   @default("")
  gstRate     Decimal? @map("gst_rate") @db.Decimal(5, 2)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, code])
  @@map("hsn_codes")
}

/// A product or service. Prices are per unit; stock is the sum of stock_movements.
model Item {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  /// goods | service
  kind            String    @default("goods")
  name            String
  code            String    @default("")
  hsn             String    @default("")
  unitId          String?   @map("unit_id") @db.Uuid
  secondaryUnitId String?   @map("secondary_unit_id") @db.Uuid
  /// 1 base unit = unitRate secondary units, e.g. 1 COIL = 90 MTR
  unitRate        Decimal?  @map("unit_rate") @db.Decimal(14, 3)
  categoryId      String?   @map("category_id") @db.Uuid
  brandId         String?   @map("brand_id") @db.Uuid
  itemGroupId     String?   @map("item_group_id") @db.Uuid
  /// size / variant within the group, e.g. "1.5 sq mm"
  series          String    @default("")
  gstRate         Decimal   @default(0) @map("gst_rate") @db.Decimal(5, 2)
  salePrice       Decimal   @default(0) @map("sale_price") @db.Decimal(14, 2)
  purchasePrice   Decimal   @default(0) @map("purchase_price") @db.Decimal(14, 2)
  mrp             Decimal   @default(0) @db.Decimal(14, 2)
  /// brand's list price (LP)
  listPrice       Decimal   @default(0) @map("list_price") @db.Decimal(14, 2)
  wholesalePrice  Decimal   @default(0) @map("wholesale_price") @db.Decimal(14, 2)
  wholesaleMinQty Decimal   @default(0) @map("wholesale_min_qty") @db.Decimal(14, 3)
  minStock        Decimal   @default(0) @map("min_stock") @db.Decimal(14, 3)
  location        String    @default("")
  /// free text about the item (Items › Bulk update items)
  description     String    @default("")
  imageUrl        String    @default("") @map("image_url")
  legacyId        String?   @map("legacy_id")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  /// deleted (never used): hidden everywhere, kept for good (archived_at is set too)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?   @map("deleted_by") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business          @relation(fields: [businessId], references: [id])
  unit          Unit?           @relation("ItemUnit", fields: [unitId], references: [id])
  secondaryUnit Unit?           @relation("ItemSecondaryUnit", fields: [secondaryUnitId], references: [id])
  category    Category?         @relation(fields: [categoryId], references: [id])
  brand       Brand?            @relation(fields: [brandId], references: [id])
  itemGroup   ItemGroup?        @relation(fields: [itemGroupId], references: [id])
  movements   StockMovement[]
  prices      ItemPrice[]
  history     PriceHistory[]
  adjustments StockAdjustment[]
  transfers   StockTransfer[]

  @@index([businessId, name])
  @@index([businessId, legacyId])
  @@map("items")
}

// ───────────────────────── Stock ─────────────────────────

model Godown {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  address    String    @default("")
  manager    String    @default("")
  phone      String    @default("")
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business          @relation(fields: [businessId], references: [id])
  movements     StockMovement[]
  adjustments   StockAdjustment[]
  transfersFrom StockTransfer[]   @relation("transferFrom")
  transfersTo   StockTransfer[]   @relation("transferTo")

  // name is unique per shop, ignoring case, among live godowns (index in SQL)
  @@map("godowns")
}

/// The stock ledger. Insert-only: a mistake is corrected with a new, opposite movement.
model StockMovement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  godownId   String   @map("godown_id") @db.Uuid
  date       DateTime @db.Date
  /// + in, − out
  qty        Decimal  @db.Decimal(14, 3)
  rate       Decimal  @default(0) @db.Decimal(14, 2)
  /// opening | purchase | sale | adjustment | transfer | return | cancel
  kind       String
  /// the document that caused it, e.g. stock_adjustment / sales_document
  sourceType String   @default("") @map("source_type")
  sourceId   String?  @map("source_id") @db.Uuid
  note       String   @default("")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item   Item   @relation(fields: [itemId], references: [id])
  godown Godown @relation(fields: [godownId], references: [id])

  @@index([businessId, itemId])
  @@index([businessId, sourceType, sourceId])
  @@map("stock_movements")
}

/// Stock adjustment document (count correction, damage, …). Cancelled, never deleted.
model StockAdjustment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  number      String
  date        DateTime  @db.Date
  itemId      String    @map("item_id") @db.Uuid
  godownId    String    @map("godown_id") @db.Uuid
  /// + add, − reduce
  qty         Decimal   @db.Decimal(14, 3)
  rate        Decimal   @default(0) @db.Decimal(14, 2)
  reason      String    @default("")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item   Item   @relation(fields: [itemId], references: [id])
  godown Godown @relation(fields: [godownId], references: [id])

  @@unique([businessId, number])
  @@map("stock_adjustments")
}

model StockTransfer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  number       String
  date         DateTime  @db.Date
  itemId       String    @map("item_id") @db.Uuid
  fromGodownId String    @map("from_godown_id") @db.Uuid
  toGodownId   String    @map("to_godown_id") @db.Uuid
  qty          Decimal   @db.Decimal(14, 3)
  note         String    @default("")
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item       Item   @relation(fields: [itemId], references: [id])
  fromGodown Godown @relation("transferFrom", fields: [fromGodownId], references: [id])
  toGodown   Godown @relation("transferTo", fields: [toGodownId], references: [id])

  @@unique([businessId, number])
  @@map("stock_transfers")
}

// ───────────────────────── Pricing ─────────────────────────

/// A price list: Retail (the item's sale price), or sale price − % / purchase price + %.
model PriceList {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  isDefault  Boolean   @default(false) @map("is_default")
  /// base | disc | mark
  rule       String    @default("base")
  value      Decimal   @default(0) @db.Decimal(7, 3)
  /// round to the nearest this many rupees; 0 = paise
  roundTo    Decimal   @default(0) @map("round_to") @db.Decimal(10, 2)
  active     Boolean   @default(true)
  legacyId   String?   @map("legacy_id")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business        @relation(fields: [businessId], references: [id])
  rules    PriceListRule[]
  prices   ItemPrice[]

  // name is unique per shop, ignoring case, among live lists (index in SQL)
  @@map("price_lists")
}

/// Which party groups get a price list automatically.
model PriceListRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  priceListId  String   @map("price_list_id") @db.Uuid
  partyGroupId String   @map("party_group_id") @db.Uuid
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceList  PriceList  @relation(fields: [priceListId], references: [id])
  partyGroup PartyGroup @relation(fields: [partyGroupId], references: [id])

  @@unique([priceListId, partyGroupId])
  @@map("price_list_rules")
}

/// A fixed price for one item in one price list (overrides the list's rule).
model ItemPrice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  price       Decimal  @db.Decimal(14, 2)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceList PriceList @relation(fields: [priceListId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([priceListId, itemId])
  @@map("item_prices")
}

/// Every price change (Price manager › History). Insert-only.
model PriceHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  /// sale | purchase | mrp | list | wholesale | pl:<price list id>
  field      String
  oldValue   Decimal? @map("old_value") @db.Decimal(14, 2)
  newValue   Decimal? @map("new_value") @db.Decimal(14, 2)
  /// how it changed, e.g. "Sale price +5%, rounded to ₹1"
  how        String   @default("")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item Item @relation(fields: [itemId], references: [id])

  @@index([businessId, itemId])
  @@map("price_history")
}

// ───────────────────────── Commission ─────────────────────────

/// Electricians / referrers who bring sales and earn commission.
model Referrer {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  phone      String    @default("")
  city       String    @default("")
  /// the same person as a party, if they also buy
  partyId    String?   @map("party_id") @db.Uuid
  legacyId   String?   @map("legacy_id")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business       Business           @relation(fields: [businessId], references: [id])
  party          Party?             @relation(fields: [partyId], references: [id])
  salesDocuments SalesDocument[]
  payouts        CommissionPayout[]

  @@map("referrers")
}

/// Commission per item category: none, percent of the line, or fixed per unit.
model CommissionRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  /// none | percent | fixed
  kind       String
  value      Decimal  @default(0) @db.Decimal(14, 2)
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([businessId, categoryId])
  @@map("commission_rules")
}

// ───────────────────────── Imports ─────────────────────────

/// One run of the importer (prototype backup → these tables).
model ImportRun {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  fileName   String   @default("") @map("file_name")
  backupAt   String   @default("") @map("backup_at")
  /// done | failed
  status     String
  counts     Json     @default("{}")
  warnings   Json     @default("[]")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("import_runs")
}

/**
 * ───────────────────────── Phase 3: transactions ─────────────────────────
 */

/// Cash in hand, bank accounts (prototype erp-accts). Each has a ledger account.
model CashBankAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  /// cash | bank
  kind           String
  name           String
  /// bank & branch, or "Shop counter"
  sub            String    @default("")
  accountNo      String    @default("") @map("account_no")
  ifsc           String    @default("")
  branch         String    @default("")
  upi            String    @default("")
  openingBalance Decimal   @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingDate    DateTime? @map("opening_date") @db.Date
  isDefault      Boolean   @default(false) @map("is_default")
  legacyId       String?   @map("legacy_id")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, legacyId])
  @@map("cash_bank_accounts")
}

/// Quotation, delivery challan, sales invoice or credit note — never deleted, only cancelled.
model SalesDocument {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  /// quotation | challan | invoice | credit_note
  kind          String
  number        String
  date          DateTime  @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  /// credit | cash (walk-in)
  mode          String    @default("credit")
  partyId       String?   @map("party_id") @db.Uuid
  /// walk-in customer, or a billing name printed instead of the party's
  cashName      String    @default("") @map("cash_name")
  cashPhone     String    @default("") @map("cash_phone")
  billName      String    @default("") @map("bill_name")
  /// gst | bos | none, fixed when saved
  taxMode       String    @map("tax_mode")
  pricesInclTax Boolean   @default(true) @map("prices_incl_tax")
  placeOfSupply String    @default("") @map("place_of_supply")
  roundOff      Boolean   @default(true) @map("round_off")
  billDiscPct   Decimal?  @map("bill_disc_pct") @db.Decimal(7, 3)
  billDiscAmt   Decimal?  @map("bill_disc_amt") @db.Decimal(14, 2)
  transport     Decimal   @default(0) @db.Decimal(14, 2)
  labour        Decimal   @default(0) @db.Decimal(14, 2)
  bankCharge    Decimal   @default(0) @map("bank_charge") @db.Decimal(14, 2)
  tcsRate       Decimal?  @map("tcs_rate") @db.Decimal(5, 2)
  /// totals worked out by packages/shared saleTotals() when saved
  itemsTotal    Decimal   @default(0) @map("items_total") @db.Decimal(14, 2)
  billDiscount  Decimal   @default(0) @map("bill_discount") @db.Decimal(14, 2)
  taxable       Decimal   @default(0) @db.Decimal(14, 2)
  tax           Decimal   @default(0) @db.Decimal(14, 2)
  cgst          Decimal   @default(0) @db.Decimal(14, 2)
  sgst          Decimal   @default(0) @db.Decimal(14, 2)
  igst          Decimal   @default(0) @db.Decimal(14, 2)
  tcs           Decimal   @default(0) @db.Decimal(14, 2)
  roundAmount   Decimal   @default(0) @map("round_amount") @db.Decimal(14, 2)
  total         Decimal   @default(0) @db.Decimal(14, 2)
  /// quotation / challan: open | converted; credit note: adjust | refund
  status        String    @default("open")
  notes         String    @default("")
  reason        String    @default("")
  /// printed details: poNo, poDate, challanNo, ewb, transport, vehicle, deliveryDate, description,
  /// attachments, quoteRefs, validTill, refundMode, commission overrides per category …
  extra         Json      @default("{}")
  /// electrician who brought the sale (commission)
  referrerId    String?   @map("referrer_id") @db.Uuid
  /// the quotation or challan this invoice came from
  sourceId      String?   @map("source_id") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy   String?   @map("cancelled_by") @db.Uuid
  cancelReason  String    @default("") @map("cancel_reason")
  /// deleted: hidden from the lists, kept for good (cancelled_at is set too: its effects are undone)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteReason  String    @default("") @map("delete_reason")
  legacyId      String?   @map("legacy_id")
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business            @relation(fields: [businessId], references: [id])
  party    Party?              @relation(fields: [partyId], references: [id])
  referrer Referrer?           @relation(fields: [referrerId], references: [id])
  lines    SalesDocumentLine[]

  @@unique([businessId, kind, number])
  @@index([businessId, kind, date])
  @@index([businessId, partyId])
  @@map("sales_documents")
}

model SalesDocumentLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  position     Int
  itemId       String?  @map("item_id") @db.Uuid
  name         String
  hsn          String   @default("")
  qty          Decimal  @db.Decimal(14, 3)
  unit         String   @default("")
  /// price-list rate before the line discount
  price        Decimal  @db.Decimal(14, 2)
  discPct      Decimal  @default(0) @map("disc_pct") @db.Decimal(12, 8)
  gstRate      Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  taxable      Decimal  @default(0) @db.Decimal(14, 2)
  tax          Decimal  @default(0) @db.Decimal(14, 2)
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  /// referral: the rate before the commission was loaded on it
  basePrice    Decimal? @map("base_price") @db.Decimal(14, 2)
  /// referral: a rule set for this line only ({t, v})
  commOverride Json?    @map("comm_override")
  /// commission: p (percent) | f (fixed per unit) | none, and the amount worked out
  commType     String   @default("none") @map("comm_type")
  commValue    Decimal  @default(0) @map("comm_value") @db.Decimal(14, 2)
  commAmount   Decimal  @default(0) @map("comm_amount") @db.Decimal(14, 2)
  /// credit note line: the invoice it returns against
  againstId    String?  @map("against_id") @db.Uuid

  business Business      @relation(fields: [businessId], references: [id])
  document SalesDocument @relation(fields: [documentId], references: [id])

  @@index([businessId, documentId])
  @@map("sales_document_lines")
}

/// Purchase order, purchase bill or debit note.
model PurchaseDocument {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  /// order | bill | debit_note
  kind          String
  number        String
  /// the supplier's own bill number
  supplierRef   String    @default("") @map("supplier_ref")
  date          DateTime  @db.Date
  /// bill: due date; order: expected delivery
  dueDate       DateTime? @map("due_date") @db.Date
  partyId       String    @map("party_id") @db.Uuid
  taxMode       String    @map("tax_mode")
  pricesInclTax Boolean   @default(false) @map("prices_incl_tax")
  interState    Boolean   @default(false) @map("inter_state")
  roundOff      Boolean   @default(true) @map("round_off")
  billDiscPct   Decimal?  @map("bill_disc_pct") @db.Decimal(7, 3)
  billDiscAmt   Decimal?  @map("bill_disc_amt") @db.Decimal(14, 2)
  transport     Decimal   @default(0) @db.Decimal(14, 2)
  labour        Decimal   @default(0) @db.Decimal(14, 2)
  itemsTotal    Decimal   @default(0) @map("items_total") @db.Decimal(14, 2)
  billDiscount  Decimal   @default(0) @map("bill_discount") @db.Decimal(14, 2)
  taxable       Decimal   @default(0) @db.Decimal(14, 2)
  tax           Decimal   @default(0) @db.Decimal(14, 2)
  cgst          Decimal   @default(0) @db.Decimal(14, 2)
  sgst          Decimal   @default(0) @db.Decimal(14, 2)
  igst          Decimal   @default(0) @db.Decimal(14, 2)
  roundAmount   Decimal   @default(0) @map("round_amount") @db.Decimal(14, 2)
  total         Decimal   @default(0) @db.Decimal(14, 2)
  /// order: open | received | cancelled
  status        String    @default("open")
  notes         String    @default("")
  reason        String    @default("")
  /// the order this bill came from
  sourceId      String?   @map("source_id") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy   String?   @map("cancelled_by") @db.Uuid
  cancelReason  String    @default("") @map("cancel_reason")
  /// deleted: hidden from the lists, kept for good (cancelled_at is set too: its effects are undone)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteReason  String    @default("") @map("delete_reason")
  legacyId      String?   @map("legacy_id")
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business               @relation(fields: [businessId], references: [id])
  party    Party                  @relation(fields: [partyId], references: [id])
  lines    PurchaseDocumentLine[]

  @@unique([businessId, kind, number])
  @@index([businessId, kind, date])
  @@index([businessId, partyId])
  @@map("purchase_documents")
}

model PurchaseDocumentLine {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  documentId String  @map("document_id") @db.Uuid
  position   Int
  itemId     String? @map("item_id") @db.Uuid
  name       String
  hsn        String  @default("")
  qty        Decimal @db.Decimal(14, 3)
  unit       String  @default("")
  rate       Decimal @db.Decimal(14, 2)
  discPct    Decimal @default(0) @map("disc_pct") @db.Decimal(9, 6)
  gstRate    Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  taxable    Decimal @default(0) @db.Decimal(14, 2)
  tax        Decimal @default(0) @db.Decimal(14, 2)
  amount     Decimal @default(0) @db.Decimal(14, 2)
  /// debit note line: the bill it returns against
  againstId  String? @map("against_id") @db.Uuid

  business Business         @relation(fields: [businessId], references: [id])
  document PurchaseDocument @relation(fields: [documentId], references: [id])

  @@index([businessId, documentId])
  @@map("purchase_document_lines")
}

/// Money received (in) or paid (out); allocations say which documents it settles.
model Payment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  /// in | out
  direction   String
  number      String
  date        DateTime  @db.Date
  partyId     String?   @map("party_id") @db.Uuid
  amount      Decimal   @db.Decimal(14, 2)
  /// Cash | UPI | Bank transfer | Cheque | Card | Commission adjust …
  mode        String
  accountId   String?   @map("account_id") @db.Uuid
  reference   String    @default("")
  notes       String    @default("")
  /// money taken on the invoice screen itself (part of that sale)
  atSale      Boolean   @default(false) @map("at_sale")
  /// the sale it was taken on (atSale), or the credit note it refunds
  sourceId    String?   @map("source_id") @db.Uuid
  /// split across modes: [{mode, amount, ref}]
  splits      Json      @default("[]")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  /// deleted (payments received): hidden from the lists, kept for good (cancelled_at is set too)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  deleteReason String   @default("") @map("delete_reason")
  legacyId    String?   @map("legacy_id")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business            @relation(fields: [businessId], references: [id])
  party       Party?              @relation(fields: [partyId], references: [id])
  allocations PaymentAllocation[]

  @@unique([businessId, direction, number])
  @@index([businessId, partyId])
  @@map("payments")
}

/// Which invoice / bill (or credit / debit note) a payment or note settles, and how much.
model PaymentAllocation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  /// document | opening (the party's opening balance)
  kind               String   @default("document")
  partyId            String?  @map("party_id") @db.Uuid
  /// a payment, or a credit/debit note adjusted against documents
  paymentId          String?  @map("payment_id") @db.Uuid
  noteId             String?  @map("note_id") @db.Uuid
  salesDocumentId    String?  @map("sales_document_id") @db.Uuid
  purchaseDocumentId String?  @map("purchase_document_id") @db.Uuid
  amount             Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])

  @@index([businessId, salesDocumentId])
  @@index([businessId, purchaseDocumentId])
  @@map("payment_allocations")
}

/// Banking › entries typed by hand: money in / out of an account, or a transfer between accounts.
model BankEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  number      String
  date        DateTime  @db.Date
  /// in | out | transfer (bank to bank) | deposit (cash → bank) | withdraw (bank → cash)
  kind        String
  accountId   String    @map("account_id") @db.Uuid
  toAccountId String?   @map("to_account_id") @db.Uuid
  amount      Decimal   @db.Decimal(14, 2)
  category    String    @default("")
  note        String    @default("")
  reference   String    @default("")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  legacyId    String?   @map("legacy_id")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, number])
  @@map("bank_entries")
}

/// Cheques received or issued; bouncing one puts the amount back on the party's account.
model Cheque {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  /// received | issued
  direction  String
  chequeNo   String    @map("cheque_no")
  bank       String    @default("")
  chequeDate DateTime  @map("cheque_date") @db.Date
  amount     Decimal   @db.Decimal(14, 2)
  partyId    String?   @map("party_id") @db.Uuid
  paymentId  String?   @map("payment_id") @db.Uuid
  /// an expense paid by cheque
  expenseId  String?   @map("expense_id") @db.Uuid
  /// pending | cleared | bounced
  status     String    @default("pending")
  accountId  String?   @map("account_id") @db.Uuid
  statusDate DateTime? @map("status_date") @db.Date
  /// bank charges for a bounce
  charges    Decimal   @default(0) @db.Decimal(14, 2)
  note       String    @default("")
  legacyId   String?   @map("legacy_id")
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
  @@map("cheques")
}

/// Banking › Reconciliation: a statement's closing balance and the entries ticked off against it.
model Reconciliation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  statementDate    DateTime @map("statement_date") @db.Date
  /// blank until the closing balance from the statement is typed in
  statementBalance Decimal? @map("statement_balance") @db.Decimal(14, 2)
  /// journal line ids ticked as on the statement
  cleared          Json     @default("[]")
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, accountId, statementDate])
  @@map("reconciliations")
}

model ExpenseCategory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])

  @@map("expense_categories")
}

model Expense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  number      String
  date        DateTime  @db.Date
  /// who was paid (optional party)
  partyId     String?   @map("party_id") @db.Uuid
  payee       String    @default("")
  mode        String    @default("Cash")
  accountId   String?   @map("account_id") @db.Uuid
  reference   String    @default("")
  taxable     Decimal   @default(0) @db.Decimal(14, 2)
  tax         Decimal   @default(0) @db.Decimal(14, 2)
  tds         Decimal   @default(0) @db.Decimal(14, 2)
  total       Decimal   @default(0) @db.Decimal(14, 2)
  notes       String    @default("")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  legacyId    String?   @map("legacy_id")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business      @relation(fields: [businessId], references: [id])
  lines    ExpenseLine[]

  @@unique([businessId, number])
  @@map("expenses")
}

model ExpenseLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String  @map("business_id") @db.Uuid
  expenseId   String  @map("expense_id") @db.Uuid
  position    Int
  categoryId  String? @map("category_id") @db.Uuid
  description String  @default("")
  qty         Decimal @default(1) @db.Decimal(14, 3)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  gstRate     Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)

  business Business @relation(fields: [businessId], references: [id])
  expense  Expense  @relation(fields: [expenseId], references: [id])

  @@map("expense_lines")
}

/// Commission paid out to an electrician (prototype erp-compay).
model CommissionPayout {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  number      String
  date        DateTime  @db.Date
  referrerId  String    @map("referrer_id") @db.Uuid
  amount      Decimal   @db.Decimal(14, 2)
  mode        String    @default("Cash")
  accountId   String?   @map("account_id") @db.Uuid
  note        String    @default("")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  legacyId    String?   @map("legacy_id")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  referrer Referrer @relation(fields: [referrerId], references: [id])

  @@unique([businessId, number])
  @@map("commission_payouts")
}

/// Chart of accounts. System accounts have a key (sales, output_cgst, receivable, cash:<id> …).
model LedgerAccount {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  key        String
  name       String
  /// asset | liability | income | expense | equity
  type       String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business      @relation(fields: [businessId], references: [id])
  lines    JournalLine[]

  @@unique([businessId, key])
  @@map("ledger_accounts")
}

/// Every document posts one balanced entry; a cancelled document's entry is marked cancelled.
model JournalEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  date        DateTime  @db.Date
  /// sales_document | purchase_document | payment | bank_entry | expense | commission_payout | opening | cheque
  sourceType  String    @map("source_type")
  sourceId    String    @map("source_id") @db.Uuid
  number      String    @default("")
  narration   String    @default("")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business      @relation(fields: [businessId], references: [id])
  lines    JournalLine[]

  @@index([businessId, sourceType, sourceId])
  @@index([businessId, date])
  @@map("journal_entries")
}

model JournalLine {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  entryId    String  @map("entry_id") @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  /// receivable / payable lines carry the party
  partyId    String? @map("party_id") @db.Uuid
  debit      Decimal @default(0) @db.Decimal(14, 2)
  credit     Decimal @default(0) @db.Decimal(14, 2)
  memo       String  @default("")

  business Business      @relation(fields: [businessId], references: [id])
  entry    JournalEntry  @relation(fields: [entryId], references: [id])
  account  LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([businessId, accountId])
  @@index([businessId, partyId])
  @@map("journal_lines")
}

// ───────────────────────── Real-time backup ─────────────────────────

/// Every change to a shop's rows, written by a trigger in the same transaction (see migration
/// 20261012120000_backup_change_log). seq is given by the packer in commit order.
model ChangeLog {
  id         BigInt   @id @default(autoincrement())
  businessId String   @map("business_id") @db.Uuid
  seq        BigInt?
  tbl        String
  /// I | U | D
  op         String   @db.Char(1)
  data       Json
  at         DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@map("change_log")
}

/// Where a shop's backups go (Google Drive, this computer) and how far each has confirmed.
model BackupDestination {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  /// drive | local
  kind           String
  enabled        Boolean   @default(true)
  cursorSeq      BigInt    @default(0) @map("cursor_seq")
  lastOkAt       DateTime? @map("last_ok_at") @db.Timestamptz(6)
  failingSince   DateTime? @map("failing_since") @db.Timestamptz(6)
  lastError      String    @default("") @map("last_error")
  attempts       Int       @default(0)
  nextTryAt      DateTime? @map("next_try_at") @db.Timestamptz(6)
  lastSnapshotAt DateTime? @map("last_snapshot_at") @db.Timestamptz(6)
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  settings       Json      @default("{}")
  /// the place's login (Google Drive: refresh token), locked; never sent out by the API
  secret         String    @default("")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  files BackupFile[]

  @@unique([businessId, kind])
  @@map("backup_destinations")
}

/// A backup file a destination has confirmed.
model BackupFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  /// changes | snapshot
  kind          String
  name          String
  afterSeq      BigInt   @map("after_seq")
  toSeq         BigInt   @map("to_seq")
  changes       Int      @default(0)
  bytes         Int
  sha256        String
  ref           String   @default("")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  destination BackupDestination @relation(fields: [destinationId], references: [id])

  @@index([destinationId, kind, toSeq])
  @@map("backup_files")
}
