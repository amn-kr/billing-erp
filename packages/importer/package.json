{
  "name": "@billing/importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "node --experimental-strip-types scripts/make-fixtures.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --shims"
  },
  "dependencies": {
    "@billing/shared": "workspace:*",
    "playwright-core": "1.56.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "vitest": "4.1.11",
    "tsup": "8.5.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
